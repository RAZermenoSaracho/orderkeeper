# Copy to .env and fill in real values locally. Never commit .env — see
# ../.claude/rules/security.md rule (a). This file documents variable
# names only; no real values belong here.
#
# Vite only exposes env vars prefixed VITE_ to client code — nothing
# secret belongs here by construction, since anything here ships to the
# browser. The frontend never holds a PRIVATE_KEY; writes are signed by
# the connected wallet, not by the app itself (see CLAUDE.md Architecture).
#
# These two aren't in CLAUDE.md's Environment Variables section yet (that
# list predates the frontend scaffold) — flagged for review, not yet
# finalized.

# Sepolia RPC endpoint used by wagmi's public client for reads.
VITE_RPC_URL=

# Deployed OrderKeeper contract address on Sepolia (see ../deployments/
# once it exists).
VITE_CONTRACT_ADDRESS=

# order-indexer's base URL, used to read order history (GET /orders).
# Same value as keeper-bot/.env's INDEXER_URL, e.g. http://localhost:3001.
VITE_INDEXER_URL=
