# Copy to .env and fill in real values locally. Never commit .env — see
# ../.claude/rules/security.md rule (a). This file documents variable
# names only; no real values belong here.

# Sepolia RPC endpoint (Alchemy) — used for reading the Chainlink feed and
# sending executeOrder() transactions.
RPC_URL=

# Operator key used to sign and send executeOrder() transactions. This is
# a separate wallet from user funds and from the contracts/ deployer key —
# never share keys between services (see CLAUDE.md Environment Variables).
PRIVATE_KEY=

# Sepolia Chainlink ETH/USD price feed address — read off-chain to decide
# *when* to trigger; the contract re-verifies this independently on-chain
# before moving funds.
CHAINLINK_ETH_USD_FEED=

# order-indexer's REST API base URL — keeper-bot reads pending orders from
# here rather than the contract directly (see README.md Design Decisions /
# CLAUDE.md Open Design Questions).
INDEXER_URL=http://localhost:3001
