# Copy to .env and fill in real values locally. Never commit .env — see
# ../.claude/rules/security.md rule (a). This file documents variable
# names only; no real values belong here.
#
# order-indexer is read-only by design (CLAUDE.md Conventions) — it never
# holds a PRIVATE_KEY, on purpose. Don't add one here.

# Sepolia RPC endpoint, WebSocket-capable (Alchemy) — used to backfill
# and poll for OrderCreated/OrderExecuted/OrderCancelled events (see
# indexer.ts).
RPC_URL=

# Local PostgreSQL connection string (Prisma). Default local dev DB name
# is orderkeeper_dev. Must include your OS/Postgres username — a bare
# "postgresql://localhost:5432/..." with no user fails to authenticate
# under peer/trust auth (Homebrew's default local setup).
DATABASE_URL="postgresql://YOUR_USERNAME@localhost:5432/orderkeeper_dev"

# HTTP port for the Fastify server.
PORT=3001

# Bind locally by default for Cloudflare Tunnel/PM2 hosting. Use 0.0.0.0 only
# when deliberate LAN access is required.
HOST=127.0.0.1

# Optional. Max block range per eth_getLogs call during backfill. Defaults
# to 10 — Alchemy's free tier hard limit. Raise this if your RPC provider
# allows a wider range, for faster catch-up after downtime.
GETLOGS_BLOCK_RANGE=

# Optional. Milliseconds to wait between backfill chunks, to stay under
# the RPC provider's rate limit proactively rather than only reacting to
# 429s after the fact. Defaults to 200. Raise this if backfill still hits
# 429 Too Many Requests with a large gap to catch up on; 0 disables it.
BACKFILL_DELAY_MS=

# Optional. Milliseconds between live event-watching polls (plain
# eth_getLogs-based, not viem's filter-based watchContractEvent — see
# indexer.ts for why). Defaults to 15000.
WATCH_POLL_INTERVAL_MS=

# Optional. Max requests per IP per RATE_LIMIT_WINDOW_MS on GET /orders.
# Defaults to 100.
RATE_LIMIT_MAX=

# Optional. Rate limit window in milliseconds for GET /orders. Defaults
# to 60000 (1 minute).
RATE_LIMIT_WINDOW_MS=

# The contract address to watch is intentionally not an env var here — it
# comes from ../deployments/ (per chain/environment), once that exists.
