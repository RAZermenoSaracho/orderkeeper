generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Mirrors OrderKeeper.PriceCondition (contracts/src/OrderKeeper.sol).
enum PriceCondition {
  GreaterOrEqual
  LessOrEqual
}

/// Mirrors OrderKeeper.OrderSide (contracts/src/OrderKeeper.sol).
/// Sell deposits ETH and receives quoteToken; Buy deposits quoteToken and
/// receives ETH.
enum OrderSide {
  Sell
  Buy
}

/// Mirrors OrderKeeper.OrderStatus (contracts/src/OrderKeeper.sol).
enum OrderStatus {
  Pending
  Executed
  Cancelled
}

/// Indexed OrderKeeper order, kept in sync with on-chain state via
/// OrderCreated / OrderExecuted / OrderCancelled events.
model Order {
  /// On-chain order id (OrderKeeper.nextOrderId sequence) — used directly
  /// as the primary key rather than introducing a separate synthetic one.
  orderId Int @id

  // --- Fields fixed at creation, from OrderCreated ---
  owner String

  /// Replaced the former `asset` column: orders now trade one fixed pair in
  /// either direction, rather than naming an asset that was only ever a
  /// price trigger and never actually swapped.
  side OrderSide

  condition PriceCondition

  /// uint256 on-chain, normalized to PRICE_DECIMALS (18). NUMERIC(78,0)
  /// preserves every possible uint256 integer exactly.
  targetPrice Decimal @db.Decimal(78, 0)

  /// The deposited amount: wei for Sell orders, quoteToken base units for
  /// Buy orders — the denomination follows `side`.
  amount Decimal @db.Decimal(78, 0)
  maxSlippageBps Int
  expiry         DateTime

  // --- Mutable lifecycle state ---
  status OrderStatus @default(Pending)

  createdAtBlock BigInt
  createdAtTx    String

  executedAtBlock BigInt?
  executedAtTx    String?
  executionPrice  Decimal? @db.Decimal(78, 0)
  keeperFee       Decimal? @db.Decimal(78, 0)
  amountOut       Decimal? @db.Decimal(78, 0)

  cancelledAtBlock BigInt?
  cancelledAtTx    String?

  // --- Indexer bookkeeping, distinct from on-chain timestamps ---
  indexedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

/// Single-row checkpoint of the last block this indexer has fully
/// processed, so a restart resumes from there rather than re-scanning from
/// genesis or silently missing events emitted while it was down.
model IndexerState {
  id                 Int    @id @default(1)
  lastProcessedBlock BigInt
}
