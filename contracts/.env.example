# Copy to .env and fill in real values locally. Never commit .env — see
# ../.claude/rules/security.md rule (a). This file documents variable
# names only; no real values belong here.

# Sepolia RPC endpoint (Alchemy/Infura). Used for deployment and for fork
# tests (`forge test --fork-url $RPC_URL`, or `--fork-url sepolia` via the
# [rpc_endpoints] alias in foundry.toml).
RPC_URL=

# Deployer key used by `forge script` to deploy contracts to Sepolia.
# Never share this key with keeper-bot/ — each service uses its own key.
PRIVATE_KEY=

# Sepolia Chainlink ETH/USD price feed address (AggregatorV3Interface).
CHAINLINK_ETH_USD_FEED=

# Sepolia Uniswap V2 router address, used by executeOrder() to perform the
# swap once the price condition is verified on-chain.
UNISWAP_ROUTER_ADDRESS=
